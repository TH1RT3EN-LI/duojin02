+MapperGraph::LoopClosureResult MapperGraph::CommitLoopClosureCandidate(
+  const LocalizedRangeScanVector & chain, LocalizedRangeScan * query,
+  const Pose2 & mean, const Matrix3 & covariance,
+  double coarse, double fine, const Pose2 & center,
+  const measurement::Evidence & evidence)
+{
+  LoopClosureResult result;
+  // Association uses the exact candidate reference geometry (including optional
+  // barycenter and sensor offset), without temporarily modifying published state.
+  LocalizedRangeScan candidate(*query,LocalizedRangeScan::MeasurementCloneTag{});
+  candidate.SetSensorPose(mean);
+  result.factor=LinkChainToScan(chain,query,candidate,mean,covariance,
+    "explicit_loop",coarse,fine,center,evidence,RegistrationFailurePolicy::RejectCandidate);
+  if (!result.factor.added()) {
+    result.decision=result.factor.status==LinkStatus::AlreadyOwned ?
+      "measurement_already_owned_no_solve" : "association_rejected_no_solve";
+  } else if (!result.factor.backend_registered) {
+    result.decision="factor_retained_backend_registration_unknown";
+  } else {
+    m_pMapper->FireBeginLoopClosure("Solving graph with associated loop factor...");
+    result.solve_attempted=m_pMapper->m_pScanOptimizer!=nullptr;
+    result.committed=CorrectPoses(query);
+    result.decision=result.committed ? "factor_added_state_committed" :
+      "factor_retained_solve_rejected";
+    m_pMapper->FireEndLoopClosure(result.committed ? "Loop closed!" :
+      "Loop factor retained; graph state not committed.");
+  }
+  RecordMapperMatch(m_pMapper->m_pScanOptimizer,"loop_commit","explicit_loop",query,
+    MatchChainIds(chain),coarse,fine,center,mean,covariance,
+    result.committed ? "committed" : "not_committed",result.decision.c_str(),-1,-1.0,-1.0,&result);
+  return result;
 }
 
