+// Observe this process's loaded component paths, then hash their current file
+// bytes. The experiment seal must separately verify that these files stayed
+// unchanged across execution; an installed marker alone proves no such binding.
+inline std::string runtimeJson()
+{
+  std::ifstream maps("/proc/self/maps");
+  if (!maps) {throw std::runtime_error("Cannot observe process library mappings");}
+  std::map<std::string, fs::path> components;
+  std::string line;
+  while (std::getline(maps, line)) {
+    const auto start = line.find('/');
+    if (start == std::string::npos) {continue;}
+    const std::string name = line.substr(start);
+    for (const auto & item : std::vector<std::pair<std::string, std::string>>{
+      {"backend", "libkartoSlamToolbox.so"}, {"frontend", "libtoolbox_common.so"},
+      {"solver", "libceres_solver_plugin.so"}, {"map_io", "libmap_io.so"}}) {
+      if (fs::path(name).filename().string().find(item.second) == 0) {
+        const auto previous = components.find(item.first);
+        if (previous != components.end() && previous->second != name) {
+          throw std::runtime_error("Multiple mapped libraries for " + item.first);
+        }
+        components[item.first] = name;
+      }
+    }
+  }
+  components["executable"] = fs::read_symlink("/proc/self/exe");
+  std::ostringstream out;
+  out << "{\"schema\":\"slam_toolbox.runtime_observation.v1\","
+    << "\"source_marker_binding\":\"not_verified_by_snapshot\","
+    << "\"hash_scope\":\"mapped_component_paths_current_file_bytes\",\"files\":[";
+  bool first = true;
+  for (const auto & item : components) {
+    if (!first) {out << ',';} first = false;
+    out << "{\"role\":" << jsonString(item.first) << ",\"path\":" << jsonString(item.second.string())
+      << ",\"sha256\":" << jsonString(sha256File(item.second)) << '}';
+  }
+  out << "],\"observed_markers\":[";
+  const char * prefixes = std::getenv("AMENT_PREFIX_PATH");
+  std::istringstream paths(prefixes ? prefixes : "");
+  std::string prefix; first = true;
+  while (std::getline(paths, prefix, ':')) {
+    const auto marker = fs::path(prefix) / "share/slam_toolbox/hardware_build.json";
+    if (!fs::is_regular_file(marker)) {continue;}
+    if (!first) {out << ',';} first = false;
+    out << "{\"path\":" << jsonString(marker.string()) << ",\"sha256\":" << jsonString(sha256File(marker)) << '}';
+  }
+  out << "]}\n";
+  return out.str();
+}
