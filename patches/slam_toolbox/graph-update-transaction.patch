+    manifest << "{\n\"schema_version\":2,\"producer\":\"slam_toolbox.SaveSnapshot.v2\","
+      << "\"snapshot_id\":" << jsonString(id) << ",\"operation\":"
+      << jsonString(finalize ? "finalize" : "snapshot") << ",\"request_id\":" << jsonString(request_id)
+      << ",\"finalized\":" << (finalize ? "true" : "false")
+      << ",\"consistency\":\"single_graph_owner_boundary\",\"files\":[";
+    bool first = true;
+    for (const auto & f : files_) {
+      if (!first) {manifest << ',';} first = false;
+      manifest << "{\"role\":" << jsonString(f.role) << ",\"path\":" << jsonString(f.path)
+        << ",\"sha256\":" << jsonString(f.sha256) << ",\"size_bytes\":" << f.size << '}';
+    }
+    manifest << "]}\n";
+    writeText(pending_ / "snapshot.json", manifest.str());
