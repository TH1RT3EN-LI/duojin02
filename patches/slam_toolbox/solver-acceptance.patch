+CeresSolver::ObjectiveEvaluation CeresSolver::EvaluateObjective()
+{
+  ObjectiveEvaluation result;
+  std::vector<int> ids;
+  for (const auto & entry : *nodes_) {
+    if (!entry.second.allFinite()) {return result;}
+    ids.push_back(entry.first);
+  }
+  std::sort(ids.begin(), ids.end());
+  ceres::Problem::EvaluateOptions evaluation_options;
+  evaluation_options.apply_loss_function = true;
+  evaluation_options.num_threads = options_.num_threads;
+  for (int id : ids) {
+    auto & pose = nodes_->at(id);
+    for (int axis = 0; axis < 3; ++axis) {
+      double * parameter = &pose(axis);
+      if (problem_->HasParameterBlock(parameter) && !problem_->IsParameterBlockConstant(parameter)) {
+        evaluation_options.parameter_blocks.push_back(parameter);
+      }
+    }
+  }
+  std::vector<double> gradient;
+  // An empty parameter list means "all" to Ceres, so request cost alone when all
+  // blocks are fixed. In that case the free-space gradient has dimension zero.
+  const bool has_free_parameters = !evaluation_options.parameter_blocks.empty();
+  if (!problem_->Evaluate(evaluation_options, &result.cost, nullptr,
+    has_free_parameters ? &gradient : nullptr, nullptr) || !std::isfinite(result.cost))
+  {
+    return result;
+  }
+  result.free_dimension = gradient.size();
+  result.free_gradient_infinity_norm = 0.0;
+  result.free_gradient_l2_norm = 0.0;
+  for (double value : gradient) {
+    if (!std::isfinite(value)) {return result;}
+    result.free_gradient_infinity_norm = std::max(result.free_gradient_infinity_norm, std::abs(value));
+    result.free_gradient_l2_norm = std::hypot(result.free_gradient_l2_norm, value);
+  }
+  result.valid = true;
+  return result;
+}
