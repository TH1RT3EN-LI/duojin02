+// This helper owns an unpublished sibling directory. Only the no-replace rename
+// publishes it; incomplete bundles are removed by the destructor.
+class BundleWriter
+{
+public:
+  explicit BundleWriter(const fs::path & target) : target_(fs::absolute(target))
+  {
+    if (target_.filename().empty() || fs::exists(target_)) {
+      throw std::runtime_error("Snapshot destination must be a new directory");
+    }
+    fs::create_directories(target_.parent_path());
+    std::string pattern = (target_.parent_path() / ("." + target_.filename().string() + ".tmp-XXXXXX")).string();
+    std::vector<char> name(pattern.begin(), pattern.end()); name.push_back(0);
+    const char * created = ::mkdtemp(name.data());
+    if (!created) {throw std::runtime_error("Cannot create snapshot staging directory");}
+    pending_ = created;
+  }
+  ~BundleWriter() {if (!pending_.empty()) {std::error_code ec; fs::remove_all(pending_, ec);}}
+  const fs::path & path() const {return pending_;}
+  void add(const std::string & role, const std::string & name)
+  {
+    const auto path = pending_ / name;
+    if (!fs::is_regular_file(path) || fs::is_symlink(path) || fs::file_size(path) == 0) {
+      throw std::runtime_error("Snapshot member missing or not a regular file: " + name);
+    }
+    syncPath(path);
+    files_.push_back({role, name, sha256File(path), fs::file_size(path)});
+  }
+  std::string publish(bool finalize, const std::string & request_id)
+  {
+    // Identity binds sorted role/path/content records and operation, excluding
+    // wall clock and directory name. It names this captured graph/raster state.
+    std::sort(files_.begin(), files_.end(), [](const auto & a, const auto & b) {return a.role < b.role;});
