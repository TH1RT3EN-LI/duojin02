+void MapperGraph::ObserveGraphDelta(const std::string & cause)
+{
+  auto owner=m_pMapper->LockGraphState();AssertHealthy();
+  ++m_UpdateState.graph_revision;
+  GraphUpdateResult result;result.decision=cause;
+  RecordUpdate("graph_delta",cause,result,nullptr);
