+  return prepared;
+}
+bool CeresSolver::CommitPrepared(const PreparedHandle&handle) {
+  boost::mutex::scoped_lock lock(nodes_mutex_);
+  if(!active_prepared_||active_prepared_->handle!=handle||active_prepared_->applied||!handle->numerical_accepted||!SnapshotEqual(SnapshotLocked(),active_prepared_->frozen_before)||
+    !SnapshotEqual(handle->before,active_prepared_->frozen_before))return false;
+  try{
+    if(handle->candidate.size()!=handle->before.nodes.size())return false;
+    AssignAbsoluteLocked(handle->candidate);
+    const auto candidate=SnapshotLocked();if(!candidate.known||candidate.nodes.size()!=handle->before.nodes.size())throw std::runtime_error("Invalid backend candidate");
+    if(handle->before.anchor_valid&&(!candidate.anchor_valid||candidate.anchor_id!=handle->before.anchor_id||!SamePose(candidate.anchor_pose,handle->before.anchor_pose)))throw std::runtime_error("Prepared anchor changed");
+    auto value=EvaluateObjective();double allowance=64*std::numeric_limits<double>::epsilon()*std::max(1.,std::abs(handle->before_cost));
+    if(!value.valid||value.cost>handle->before_cost+allowance)throw std::runtime_error("Prepared objective failed commit recheck");
+    active_prepared_->applied=true;last_solve_result_.committed=value;WritePreparedDiagnostic("backend_candidate_applied");return true;
+  }catch(...){try{AssignAbsoluteLocked(handle->before.nodes);active_prepared_->applied=false;last_solve_result_.committed=EvaluateObjective();}catch(...){}return false;}
+}
+bool CeresSolver::AbortPrepared(const PreparedHandle&handle) {
+  boost::mutex::scoped_lock lock(nodes_mutex_);
+  if(!active_prepared_||active_prepared_->handle!=handle)return false;
+  try{
+    auto current=SnapshotLocked();auto expected=active_prepared_->frozen_before;
+    // Candidate poses are the sole allowed difference under the active guard.
+    if(current.nodes.size()!=expected.nodes.size())return false;
+    for(size_t i=0;i<current.nodes.size();++i)if(current.nodes[i].first!=expected.nodes[i].first)return false;
+    current.nodes=expected.nodes;current.anchor_pose=expected.anchor_pose;
+    if(!SnapshotEqual(current,expected))return false;
+    AssignAbsoluteLocked(expected.nodes);last_solve_result_.committed=EvaluateObjective();corrections_.clear();
+    if(!SnapshotEqual(SnapshotLocked(),expected)||!last_solve_result_.committed.valid)return false;
+    const double tol=64*std::numeric_limits<double>::epsilon()*std::max(1.,std::abs(handle->before_cost));
+    if(std::abs(last_solve_result_.committed.cost-handle->before_cost)>tol)return false;
+    WritePreparedDiagnostic("optimization_aborted");active_prepared_.reset();compute_state_=ComputeState::Rejected;return true;
+  }catch(...){return false;}
+}
+bool CeresSolver::FinalizePrepared(const PreparedHandle&handle) {
+  boost::mutex::scoped_lock lock(nodes_mutex_);
+  if(!active_prepared_||active_prepared_->handle!=handle||!active_prepared_->applied)return false;
+  try{
+    auto expected=active_prepared_->frozen_before;expected.nodes=handle->candidate;
+    if(!SnapshotEqual(SnapshotLocked(),expected))return false;
+    last_solve_result_.committed=EvaluateObjective();if(!last_solve_result_.committed.valid)return false;
+    corrections_=handle->candidate;WritePreparedDiagnostic("optimization_end");
+    ++pose_revision_;active_prepared_.reset();compute_state_=ComputeState::Accepted;return true;
+  }catch(...){return false;}
+}
+void CeresSolver::Compute() {
+  auto prepared=PrepareSolve();
+  if(!prepared)return;
+  if(!prepared->numerical_accepted||!CommitPrepared(prepared)||!FinalizePrepared(prepared)){
+    if(!AbortPrepared(prepared))throw std::runtime_error("Legacy Compute failed to restore prepared backend");
+  }
+}
