+// Common SE(2) logarithm chart. Its cut is explicit, not candidate-order dependent.
+struct ChartPoint {Vec value; Mat jacobian;};
+inline ChartPoint logChart(const Pose2 & anchor,const Pose2 & pose) {
+  const double f=angle(pose.GetHeading()-anchor.GetHeading());
+  if(!std::isfinite(f) || std::abs(f)>=KT_PI-1e-6 ||
+     !std::isfinite(pose.GetX()) || !std::isfinite(pose.GetY()) ||
+     !std::isfinite(anchor.GetX()) || !std::isfinite(anchor.GetY()))
