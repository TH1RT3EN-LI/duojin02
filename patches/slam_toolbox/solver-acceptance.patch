+    double free_gradient_l2_norm{std::numeric_limits<double>::quiet_NaN()};
+    std::size_t free_dimension{0};
+  };
+  struct SolveResult
+  {
+    bool attempted{false}, accepted{false}, free_gradient_tolerance_met{false};
+    std::string decision{"not_run"};
+    std::string exception_message;
+    ObjectiveEvaluation before, candidate, committed;
+    ceres::Solver::Summary native_summary;
+    double anchor_max_component_change{0.0};
+    double maximum_node_translation_change_m{0.0};
+    double maximum_node_yaw_change_rad{0.0};
+    double allowed_cost_increase{0.0};
+  };
+  const SolveResult & GetLastSolveResult() const {return last_solve_result_;}
+
   CeresSolver();
