+  if (index<0 || static_cast<std::size_t>(index)>=GetEdges().size()) {throw std::out_of_range("graph edge index");}
+  Graph<LocalizedRangeScan>::RemoveEdge(index);ObserveGraphDelta("factor_removed");
+}
+void MapperGraph::RemoveVertex(const Name & name, const int & index)
+{
+  auto owner=m_pMapper->LockGraphState();AssertHealthy();
+  auto sensor=m_Vertices.find(name);
+  if (sensor==m_Vertices.end() || sensor->second.count(index)==0) {throw std::out_of_range("graph vertex index");}
+  Graph<LocalizedRangeScan>::RemoveVertex(name,index);ObserveGraphDelta("node_removed");
+}
+bool MapperGraph::RegistryMatchesBackend() const
+{
+  auto * solver=m_pMapper->m_pScanOptimizer;
+  if (!solver || !solver->SupportsPreparedTransactions()) {return false;}
+  return RegistryMatchesBackend(solver->GetBackendSnapshot());
+}
+bool MapperGraph::RegistryMatchesBackend(const GraphBackendSnapshot & backend) const
+{
+  if (!backend.known) {return false;}
+  std::set<int> ids;
+  for (const auto & sensor : GetVertices()) for (const auto & item : sensor.second) {
+    if (!item.second || !item.second->GetObject() ||
+      !ids.insert(item.second->GetObject()->GetUniqueId()).second) {return false;}
+  }
+  std::set<int> backend_ids;
+  for (const auto & node : backend.nodes) {
+    if (!UpdatePoseFinite(node.second) || !backend_ids.insert(node.first).second) {return false;}
+  }
+  if (ids!=backend_ids || GetEdges().size()!=backend.constraints.size()) {return false;}
+  std::map<std::pair<int,int>,LinkInfo *> factors;
+  for (auto * edge : GetEdges()) {
+    if (!edge || !edge->GetSource() || !edge->GetTarget()) {return false;}
+    auto * info=dynamic_cast<LinkInfo *>(edge->GetLabel());
+    auto key=std::make_pair(edge->GetSource()->GetObject()->GetUniqueId(),edge->GetTarget()->GetObject()->GetUniqueId());
+    if (!info || !factors.emplace(key,info).second) {return false;}
+  }
+  std::set<std::pair<int,int>> seen;
+  for (const auto & record : backend.constraints) {
+    auto key=std::make_pair(record.source_id,record.target_id);auto found=factors.find(key);
+    if (found==factors.end() || !seen.insert(key).second || record.registration_id==0) {return false;}
+    auto * info=found->second;
+    if (!UpdatePoseEqual(info->GetPoseDifference(),record.mean) ||
+      !UpdateEvidenceEqual(info->GetEvidence(),record.evidence)) {return false;}
+    for (int r=0;r<3;++r) for (int c=0;c<3;++c) {
+      if (info->GetCovariance()(r,c)!=record.covariance(r,c)) {return false;}
+    }
+  }
+  return true;
+}
+std::string MapperGraph::GetUpdateMetadataJson(const GraphBackendSnapshot * captured) const
+{
+  auto owner=m_pMapper->LockGraphState();
+  auto * solver=m_pMapper->m_pScanOptimizer;
+  const auto owned=captured ? GraphBackendSnapshot{} :
+    (solver ? solver->GetBackendSnapshot() : GraphBackendSnapshot{});
+  const auto & backend=captured ? *captured : owned;
+  std::ostringstream content;
+  for (const auto & sensor : GetVertices()) for (const auto & item : sensor.second) {
+    content << item.second->GetObject()->GetUniqueId() << ':';
+    IdentityString(content,sensor.first.ToString());content << item.first << ';';
+  }
+  for (auto * edge : GetEdges()) {
+    auto * info=dynamic_cast<LinkInfo *>(edge->GetLabel());
+    content << edge->GetSource()->GetObject()->GetUniqueId() << ',' << edge->GetTarget()->GetObject()->GetUniqueId() << ':';
+    if (info) {
+      IdentityPose(content,info->GetPoseDifference());
+      for (int r=0;r<3;++r) for (int c=0;c<3;++c) {content << std::hexfloat << info->GetCovariance()(r,c) << ';';}
+      IdentityString(content,info->GetEvidence().context);
+      for (const auto & source : info->GetEvidence().raw_sources) {IdentityString(content,source);}
+      for (const auto & view : info->GetEvidence().views) {IdentityString(content,UpdateViewDigest(view));}
+      // Digests are diagnostics only. Registry and owner identity use full bytes.
+    }
+  }
+  content << "anchor:" << backend.anchor_valid << ':' << backend.anchor_id << ':';
+  if (backend.anchor_valid) {IdentityPose(content,backend.anchor_pose);}
+  const auto & s=m_UpdateState;
+  std::ostringstream out;out << std::setprecision(17)
+    << "{\"schema\":\"graph-update.v1\",\"reset_epoch\":" << s.reset_epoch
+    << ",\"graph_revision\":" << s.graph_revision << ",\"covered_graph_revision\":" << s.covered_graph_revision
+    << ",\"reference_pose_revision\":" << s.reference_pose_revision << ",\"backend_pose_revision\":" << backend.pose_revision
+    << ",\"backend_topology_revision\":" << backend.topology_revision << ",\"backend_epoch\":" << backend.epoch
+    << ",\"backend_known\":" << (backend.known?"true":"false") << ",\"commit_id\":" << s.commit_id
+    << ",\"request_count\":" << s.request_count << ",\"attempt_id\":" << s.attempt_id
+    << ",\"last_attempted_graph_revision\":" << s.last_attempted_graph_revision
+    << ",\"last_attempted_query\":" << s.last_attempted_query
+    << ",\"registered_factor_count\":" << backend.constraints.size()
+    << ",\"node_count\":" << backend.nodes.size() << ",\"faulted\":" << (s.faulted?"true":"false")
+    << ",\"has_uncovered_graph\":" << (s.graph_revision>s.covered_graph_revision?"true":"false")
+    << ",\"covered_means\":\"accepted_joint_update_not_stationarity\",\"policy\":";
+  MatchJsonString(out,s.policy);out << ",\"anchor_valid\":" << (backend.anchor_valid?"true":"false")
+    << ",\"anchor_id\":" << backend.anchor_id << ",\"anchor_pose\":";MatchJsonPose(out,backend.anchor_pose);
+  out << ",\"objective_model\":";MatchJsonString(out,backend.objective_model);
+  out << ",\"seed_policy\":";MatchJsonString(out,s.seed_policy);
+  out << ",\"last_decision\":";MatchJsonString(out,s.last_decision);
+  out << ",\"last_attempted_profile\":";MatchJsonString(out,s.last_attempted_profile);
+  out << ",\"solver_options_complete\":" << (backend.solver_options_complete?"true":"false")
+    << ",\"diagnostics_enabled\":" << (backend.diagnostics_enabled?"true":"false")
+    << ",\"solver_options\":";MatchJsonString(out,backend.solver_options);
+  out << ",\"backend_seed_digest_fnv1a64\":";MatchJsonString(out,UpdateSeedDigest(backend.nodes));
+  out << ",\"graph_content_digest_fnv1a64\":";MatchJsonString(out,UpdateDigest(content.str()));
+  out << ",\"integrity_scope\":\"full_snapshot_actual_registry_checked\""
+    << ",\"digest_scope\":\"diagnostic_content_including_immutable_view_hashes;identity_uses_full_bytes\"} ";
+  return out.str();
+}
