+bool Mapper::RestoreGraphCheckpoint()
+{
+  auto owner=LockGraphState();
+  if (!m_pGraph || !m_pScanOptimizer || !m_pScanOptimizer->SupportsPreparedTransactions()) {return false;}
+  m_pGraph->AssertHealthy();
+  if (!m_pGraph->RegistryMatchesBackend()) {return false;}
+  if (!m_CheckpointKnown) {
