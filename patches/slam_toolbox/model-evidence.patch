+Edge<LocalizedRangeScan> * MapperGraph::FindMeasurementOwner(const measurement::Evidence & evidence) const
+{
+  if (!evidence.known()) return nullptr;
+  for (auto * edge : GetEdges()) {
+    if (!edge) continue;
+    auto * info=dynamic_cast<LinkInfo *>(edge->GetLabel());
+    if (!info || !(info->GetEvidence()==evidence)) continue;
+    bool sourceLive=false,targetLive=false;
+    for (const auto & sensor : GetVertices()) for (const auto & vertex : sensor.second) {
+      sourceLive=sourceLive || vertex.second==edge->GetSource();
+      targetLive=targetLive || vertex.second==edge->GetTarget();
+    }
+    if(sourceLive && targetLive) return edge;
+  }
+  return nullptr;
+}
