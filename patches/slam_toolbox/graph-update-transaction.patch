+    const bool drained = pending_physical_scans_.empty() && snapshotInputIdle();
+    if (finalize && (!drained || !isPaused(NEW_MEASUREMENTS))) {
+      throw std::runtime_error("Finalize requires paused admissions and drained input queues");
+    }
+    if (finalize) {
+      phase = "native_finalize";
+      const auto * graph = mapper->GetGraph();
+      const auto before_revision = graph ? graph->GetUpdateState().graph_revision : 0;
+      const auto before_commit = graph ? graph->GetUpdateState().commit_id : 0;
+      karto::GraphUpdateResult result;
+      try {
+        result = mapper->FinalizeGraph(req->request_id);
+      } catch (...) {
+        // A diagnostic write can fail after the joint numerical commit. Observe
+        // its outcome before releasing either owner lock; an outer observation
+        // could race another graph mutation or mistake an old request for it.
+        if (graph) {
+          const auto & current = graph->GetUpdateState();
+          if (current.graph_revision == before_revision && current.commit_id > before_commit &&
+            current.covered_graph_revision == current.graph_revision)
+          {
+            resp->state_committed = true;
+            resp->commit_id = current.commit_id;
+          }
+          try {
+            const auto saved = current.finalize_requests.find(req->request_id);
+            if (solver_ && saved != current.finalize_requests.end() && saved->second.committed &&
+              saved->second.commit_id > 0 && saved->second.commit_id <= current.commit_id &&
+              saved->second.graph_revision == current.graph_revision &&
+              saved->second.covered_graph_revision == current.graph_revision &&
+              saved->second.reference_pose_revision == current.reference_pose_revision)
+            {
+              const auto backend = solver_->GetBackendSnapshot();
+              if (backend.known && saved->second.backend_pose_revision == backend.pose_revision) {
+                resp->state_committed = true;
+                resp->commit_id = saved->second.commit_id;
+              }
+            }
+          } catch (...) {
+            // Preserve the original failure and any observed new joint commit
+            // even when a plugin cannot provide its optional readback.
+          }
+        }
+        throw;
+      }
+      resp->state_committed = result.committed;
+      resp->commit_id = result.commit_id;
+      if (!result.committed || result.covered_graph_revision != result.graph_revision) {
+        throw std::runtime_error("Finalize did not commit full graph coverage: " + result.decision);
+      }
+    }
+    phase = "artifact_persistence";
+    mapper->CaptureGraphCheckpoint();
+    nav_msgs::msg::OccupancyGrid raster;
+    if (!renderMapLocked(raster)) {throw std::runtime_error("No reference map is available");}
+    nav2_map_server::SaveParameters parameters;
+    parameters.map_file_name = (bundle.path() / "map").string();
+    parameters.image_format = "pgm";
+    parameters.mode = nav2_map_server::MapMode::Trinary;
+    parameters.free_thresh = 0.196;
+    parameters.occupied_thresh = 0.65;
+    if (!nav2_map_server::saveMapToFile(raster, parameters)) {throw std::runtime_error("Native raster writer failed");}
+    bundle.add("yaml", "map.yaml"); bundle.add("image", "map.pgm");
+    if (req->include_graph) {
+      if (!serialization::write((bundle.path() / "graph").string(), *mapper, *dataset_, shared_from_this())) {
+        throw std::runtime_error("Graph archive writer failed");
+      }
+      // The helper's metadata is the same locked state; publish one canonical sidecar.
+      std::filesystem::rename(bundle.path() / "graph.graph_update.json", bundle.path() / "graph_update.json");
+      bundle.add("posegraph", "graph.posegraph"); bundle.add("data", "graph.data");
+    } else {
+      serialization::writeText(bundle.path() / "graph_update.json", mapper->GetGraphUpdateMetadataJson());
+    }
+    serialization::writeText(bundle.path() / "scan_geometry.json", duojin02_scan_geometry::contractJson(scan_geometry_config_));
+    serialization::writeText(bundle.path() / "input_boundary.json",
+      std::string("{\"admissions_paused\":") + (isPaused(NEW_MEASUREMENTS) ? "true" : "false") +
+      ",\"queues_drained\":" + (drained ? "true" : "false") + "}\n");
+    {std::lock_guard<std::mutex> registry(laser_registry_mutex_);
+      serialization::writeText(bundle.path() / "laser_bindings.json", laser_binding_contract::capture(
+        lasers_, *dataset_, legacy_laser_binding_pending_, laser_binding_history_));}
+    bundle.add("laser_bindings", "laser_bindings.json");
+    bundle.add("graph_update", "graph_update.json"); bundle.add("scan_geometry", "scan_geometry.json");
+    bundle.add("input_boundary", "input_boundary.json");
+    serialization::writeText(bundle.path() / "runtime.json", serialization::runtimeJson());
+    bundle.add("runtime", "runtime.json");
+    resp->snapshot_id = bundle.publish(finalize, req->request_id);
+    resp->manifest_path = (std::filesystem::absolute(filename) / "snapshot.json").string();
+    resp->finalized = finalize;
+    resp->result = resp->RESULT_SUCCESS;
+    resp->message = finalize ? "Finalized graph snapshot published" : "Reference/backend snapshot published without solving";
+  } catch (const karto::Exception & error) {
+    resp->message = "request_id=" + req->request_id + " commit_id=" + std::to_string(resp->commit_id) +
+      " phase=" + phase + " state_committed=" + (resp->state_committed ? "true" : "false") + ": " + error.GetErrorMessage();
+    RCLCPP_ERROR(get_logger(), "Snapshot request failed: %s", resp->message.c_str());
+  } catch (const std::exception & error) {
+    resp->message = "request_id=" + req->request_id + " commit_id=" + std::to_string(resp->commit_id) +
+      " phase=" + phase + " state_committed=" + (resp->state_committed ? "true" : "false") + ": " + error.what();
+    RCLCPP_ERROR(get_logger(), "Snapshot request failed: %s", resp->message.c_str());
+  }
+  return true;
+}
