+void CeresSolver::WritePreparedDiagnostic(const char * phase) {
+  WriteDiagnosticState(phase,&last_solve_result_.native_summary);
+  if(!diagnostics_.is_open()||!active_prepared_)return;
+  const auto& p=*active_prepared_->handle;
+  diagnostics_<<"{\"event\":\"prepared_candidate\",\"ticket\":"<<p.ticket<<",\"phase\":"<<JsonString(phase)<<",\"numerically_accepted\":"<<(p.numerical_accepted?"true":"false")<<",\"joint_committed\":false,\"candidate_nodes\":[";
+  for(size_t i=0;i<p.candidate.size();++i){if(i)diagnostics_<<',';const auto&e=p.candidate[i];diagnostics_<<'['<<e.first<<','<<JsonNumber{e.second.GetX()}<<','<<JsonNumber{e.second.GetY()}<<','<<JsonNumber{e.second.GetHeading()}<<']';}
+  diagnostics_<<"],\"successful_noninitial_steps\":"<<p.successful_steps<<"}\n";FlushDiagnostics();
+}
+karto::ScanSolver::PreparedHandle CeresSolver::PrepareSolve(const std::string& requested) {
+  boost::mutex::scoped_lock lock(nodes_mutex_);RequireNoPrepared("PrepareSolve");
+  compute_state_=ComputeState::Rejected;
+  const std::string profile=requested=="configured"?configured_profile_:requested;
+  if(profile!="normal"&&profile!="strict")throw std::invalid_argument("Unknown solver profile");
+  EnsureAnchorLocked();const auto before=SnapshotLocked();
