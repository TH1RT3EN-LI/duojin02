+std::shared_ptr<measurement::ViewPayload> MeasurementView(const LocalizedRangeScan * scan)
+{
+  std::ostringstream bytes; bytes << scan->GetMeasurementIdentityPayload();
+  IdentityParameters(bytes, *scan->GetLaserRangeFinder());
+  std::string payload = bytes.str();
+  // Exact-byte interning: no hash collision can cause ownership. Weak entries do
+  // not retain scan payloads after all their graph/archive owners are removed.
+  static std::mutex mutex;
+  static std::map<std::string, std::vector<std::weak_ptr<measurement::ViewPayload>>> cache;
+  std::lock_guard<std::mutex> lock(mutex);
+  // Incremental global GC also retires keys never visited again after Reset or
+  // rolling-window deletion. Budget exceeds new-key insertion rate; cache metadata
+  // cannot accumulate one dead entry per historical scan indefinitely.
+  static auto cursor=cache.end();
+  for(int budget=0;budget<16 && !cache.empty();++budget) {
+    if(cursor==cache.end())cursor=cache.begin();
+    auto current=cursor++;
+    auto & entries=current->second;
+    entries.erase(std::remove_if(entries.begin(),entries.end(),
+      [](const std::weak_ptr<measurement::ViewPayload> & item){return item.expired();}),entries.end());
+    if(entries.empty())cache.erase(current);
+  }
+  auto & bucket = cache[RawSource(scan)];
+  for (auto it = bucket.begin(); it != bucket.end();) {
+    if (auto old = it->lock()) {if (old->bytes == payload) return old; ++it;}
+    else it = bucket.erase(it);
+  }
+  auto view = std::make_shared<measurement::ViewPayload>(std::move(payload)); bucket.push_back(view); return view;
