Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: rviz_common/Time
    Name: Time
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 39; 47
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 20
      Color: 75; 83; 99
    - Class: rviz_default_plugins/Map
      Name: Live SLAM map
      Enabled: true
      Alpha: 0.65
      Color Scheme: map
      Draw Behind: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/RobotModel
      Name: Full CAD robot
      Enabled: true
      Alpha: 1
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/LaserScan
      Name: Filtered horizontal lidar
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 255; 85; 60
      Decay Time: 0.1
    - Class: rviz_default_plugins/LaserScan
      Name: Raw lidar including chassis
      Enabled: true
      Topic:
        Value: /sim/lidar/raw
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 255; 180; 45
      Decay Time: 0.1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Axes: true
      Show Names: true
      Marker Scale: 0.1
    - Class: rviz_default_plugins/Image
      Name: Head camera
      Enabled: true
      Image Topic:
        Value: /dual_arm/head_camera_link/image
        Depth: 2
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Transport Hint: raw
    - Class: rviz_default_plugins/Image
      Name: Left wrist camera
      Enabled: true
      Image Topic:
        Value: /dual_arm/left_camera_link/image
        Depth: 2
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Transport Hint: raw
    - Class: rviz_default_plugins/Image
      Name: Right wrist camera
      Enabled: true
      Image Topic:
        Value: /dual_arm/right_camera_link/image
        Depth: 2
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Transport Hint: raw
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Robot and map
      Distance: 5
      Pitch: 0.65
      Yaw: 0.75
      Focal Point: {X: 0, Y: 0, Z: 0.3}
      Target Frame: map
    Saved:
      - Class: rviz_default_plugins/TopDownOrtho
        Name: Map overhead
        Scale: 100
        X: 0
        Y: 0
        Angle: 0
        Target Frame: map
      - Class: rviz_default_plugins/Orbit
        Name: Lidar layer inspection
        Distance: 0.9
        Pitch: 0.08
        Yaw: 1.57
        Focal Point: {X: 0, Y: 0, Z: 0.143308}
        Target Frame: base_footprint
  Enabled: true
  Name: root
Window Geometry:
  Width: 1450
  Height: 1000
  X: 70
  Y: 80
  Head camera: {collapsed: false}
  Left wrist camera: {collapsed: false}
  Right wrist camera: {collapsed: false}
