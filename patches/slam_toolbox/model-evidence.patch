+// Identity is full canonical estimator context plus exact immutable view bytes.
+// Shared payload pointers avoid repeating every reference scan in every edge archive.
+struct ViewPayload {
+  std::string bytes;
+  explicit ViewPayload(std::string value = {}) : bytes(std::move(value)) {}
+  bool operator==(const ViewPayload & other) const {return bytes==other.bytes;}
+  bool operator!=(const ViewPayload & other) const {return !(*this==other);}
+  template<class Archive> void serialize(Archive&ar,const unsigned int) {ar&bytes;}
+};
