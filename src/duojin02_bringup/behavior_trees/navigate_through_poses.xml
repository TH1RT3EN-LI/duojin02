<!-- Existing periodic planning and controller algorithms are retained.
     Recovery needs an explicit negative path-check response and a changed plan.
     Service failures are not interpreted as obstacle evidence. -->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RestartOnGoalUpdate goals="{goals}">
      <PipelineSequence name="NavigateWithReplanning">
      <RateController hz="0.333">
        <ReactiveSequence>
          <RemovePassedGoals input_goals="{goals}" output_goals="{goals}" radius="0.7" robot_base_frame="base_footprint"/>
          <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"/>
        </ReactiveSequence>
      </RateController>
      <RecoveryNode number_of_retries="1" name="ReplanRejectedPath">
        <FollowPath path="{path}" controller_id="FollowPath"/>
        <Sequence name="RecoverWithChangedPath">
          <PathNeedsReplan path="{path}"/>
          <ComputePathThroughPoses goals="{goals}" path="{replacement_path}" planner_id="GridBased"/>
          <AcceptChangedPath old_path="{path}" new_path="{replacement_path}" path="{path}"/>
        </Sequence>
      </RecoveryNode>
      </PipelineSequence>
    </RestartOnGoalUpdate>
  </BehaviorTree>
</root>
