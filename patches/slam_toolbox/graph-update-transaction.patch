+/*****************************************************************************/
+bool SlamToolbox::loadSnapshotCallback(
+  const std::shared_ptr<rmw_request_id_t>,
+  const std::shared_ptr<slam_toolbox::srv::LoadSnapshot::Request> req,
+  std::shared_ptr<slam_toolbox::srv::LoadSnapshot::Response> resp)
+{
+  resp->result = resp->RESULT_FAILED;
+  resp->state_committed = false;
+  resp->migration_policy = "unknown";
+  std::lock_guard<std::recursive_mutex> dispatch(physical_dispatch_mutex_);
+  const karto::Mapper * before = nullptr;
+  {boost::mutex::scoped_lock lock(smapper_mutex_); before = smapper_->getMapper();}
+  auto observe = [&]() {
+      boost::mutex::scoped_lock lock(smapper_mutex_);
+      auto * current = smapper_->getMapper();
+      resp->state_committed = current != before;
+      auto owner = current->LockGraphState();
+      resp->graph_update_json = current->GetGraphUpdateMetadataJson();
+      if (resp->state_committed) {
+        resp->migration_policy = current->HasGraphCheckpoint() ?
+          "exact_backend_reference_checkpoint" : "mapper_seed_fallback";
+      }
+    };
+  try {
+    std::filesystem::path normalized(req->filename);
+    if (normalized.extension() == ".posegraph") {normalized.replace_extension();}
+    std::string readable = normalized.string();
+    if (snap_utils::isInSnap()) {readable = snap_utils::getSnapPath() + "/" + readable;}
+    if (std::filesystem::is_directory(readable)) {
+      // Validate before extracting the source ID. The staging archive reader
+      // independently checks all members again before parsing native objects.
+      serialization::graphPrefix(readable);
+      boost::property_tree::ptree manifest;
+      boost::property_tree::read_json((std::filesystem::path(readable) / "snapshot.json").string(), manifest);
+      resp->snapshot_id = manifest.get<std::string>("snapshot_id");
+    }
+    auto legacy = std::make_shared<slam_toolbox::srv::DeserializePoseGraph::Request>();
+    auto legacy_response = std::make_shared<slam_toolbox::srv::DeserializePoseGraph::Response>();
+    legacy->filename = normalized.string();
+    legacy->match_type = req->match_type;
+    legacy->initial_pose = req->initial_pose;
+    // Keep derived mode restrictions and the single existing staging transaction.
+    const bool loaded = deserializePoseGraphCallback(nullptr, legacy, legacy_response);
+    observe();
+    if (!loaded || !resp->state_committed) {
+      resp->message = resp->state_committed ? "LoadSnapshot state committed but subsequent processing failed" :
+        "LoadSnapshot rejected; live graph retained; inspect native diagnostics";
+      RCLCPP_ERROR(get_logger(), "%s", resp->message.c_str());
+      return true;
+    }
+    resp->result = resp->RESULT_SUCCESS;
+    resp->message = "Pure snapshot load committed; implicit_native_solves=0; " + resp->migration_policy;
+  } catch (const karto::Exception & error) {
+    resp->message = error.GetErrorMessage();
+    try {observe();} catch (...) {}
+  } catch (const std::exception & error) {
+    resp->message = error.what();
+    try {observe();} catch (...) {}
+  }
+  if (resp->result != resp->RESULT_SUCCESS) {
+    RCLCPP_ERROR(get_logger(), "LoadSnapshot failed; state_committed=%s source_snapshot_id=%s: %s",
+      resp->state_committed ? "true" : "false", resp->snapshot_id.c_str(), resp->message.c_str());
+  }
+  return true;
+}
