+bool SamePose(const karto::Pose2 & a,const karto::Pose2 & b) {
+  return a.GetX()==b.GetX() && a.GetY()==b.GetY() && a.GetHeading()==b.GetHeading();
+}
+karto::measurement::Evidence CopyEvidence(const karto::measurement::Evidence& source) {
+  // Prepared measurement payloads are logically immutable and shared by all
+  // factors/snapshots. Duplicating beam bytes per factor would be unbounded.
+  return source;
+}
+bool SameEvidence(const karto::measurement::Evidence&a,const karto::measurement::Evidence&b) {
+  if(a.known()||b.known()) {
+    if(!a.known()||!b.known()||a.context!=b.context||a.raw_sources!=b.raw_sources||a.views.size()!=b.views.size())return false;
+    for(size_t i=0;i<a.views.size();++i)if(a.views[i]!=b.views[i]&&*a.views[i]!=*b.views[i])return false;
+    return true;
+  }
+  return a.context.empty()&&b.context.empty()&&a.views.empty()&&b.views.empty()&&a.raw_sources.empty()&&b.raw_sources.empty();
+}
+bool SameConstraint(const karto::ScanSolver::ConstraintRecord&a,const karto::ScanSolver::ConstraintRecord&b,bool ids) {
+  if(a.source_id!=b.source_id||a.target_id!=b.target_id||(ids&&a.registration_id!=b.registration_id)||!SamePose(a.mean,b.mean)||!SameEvidence(a.evidence,b.evidence))return false;
+  for(int i=0;i<3;++i)for(int j=0;j<3;++j)if(a.covariance(i,j)!=b.covariance(i,j))return false;
+  return true;
+}
