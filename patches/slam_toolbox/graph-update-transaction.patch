+  auto prepared=std::make_shared<PreparedSolve>();prepared->ticket=++prepared_sequence_;prepared->before=before;prepared->profile=profile;
+  try {
+    if(profile=="strict"){options_.function_tolerance=1e-13;options_.gradient_tolerance=1e-10;options_.parameter_tolerance=1e-13;options_.max_num_iterations=500;}
+    last_profile_=profile;last_solve_options_=options_;prepared->solver_options=OptionsText(options_);
+    RunNumericalSolve();prepared->numerical_accepted=last_solve_result_.accepted;prepared->decision=last_solve_result_.decision;
+    if(prepared->numerical_accepted)prepared->candidate=corrections_;
+    std::sort(prepared->candidate.begin(),prepared->candidate.end(),[](const auto&a,const auto&b){return a.first<b.first;});
+    prepared->before_cost=last_solve_result_.before.cost;prepared->candidate_cost=last_solve_result_.candidate.cost;
+    prepared->free_gradient_infinity_norm=last_solve_result_.candidate.free_gradient_infinity_norm;prepared->free_dimension=last_solve_result_.candidate.free_dimension;prepared->gradient_tolerance_met=last_solve_result_.free_gradient_tolerance_met;
+    for(const auto&i:last_solve_result_.native_summary.iterations)if(i.iteration>0&&i.step_is_successful)++prepared->successful_steps;
+  } catch(...) {
+    for(const auto&e:oldValues)nodes_->at(e.first)=e.second;options_=savedOptions;corrections_.clear();throw;
+  }
+  for(const auto&e:oldValues)nodes_->at(e.first)=e.second;options_=savedOptions;corrections_.clear();
+  if(!SnapshotEqual(SnapshotLocked(),before))throw std::runtime_error("PrepareSolve failed to restore complete backend registry/values");
+  active_prepared_=std::make_unique<ActivePrepared>();active_prepared_->handle=prepared;
+  active_prepared_->frozen_before=SnapshotLocked();
