<CycloneDDS>
  <Domain Id="any">
    <Discovery>
      <!-- Native sensors, estimator, localization, navigation and evaluator
           each own DDS contexts, also on isolated loopback networks. -->
      <MaxAutoParticipantIndex>99</MaxAutoParticipantIndex>
    </Discovery>
    <Internal>
      <!-- Bound per-writer acknowledgement draining after the simulator
           graph closes; runtime reliable delivery remains enabled. -->
      <WriterLingerDuration>200 ms</WriterLingerDuration>
    </Internal>
  </Domain>
</CycloneDDS>
