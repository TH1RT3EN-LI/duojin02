+builtin_interfaces::msg::Time SlamToolbox::physicalScanStamp(
+  const sensor_msgs::msg::LaserScan & scan) const
+{
+  return duojin02_scan_geometry::stampMsg(
+    duojin02_scan_geometry::referenceStampNs(scan, scan_geometry_config_));
+}
+
+bool SlamToolbox::physicalOdomPose(const sensor_msgs::msg::LaserScan & scan, Pose2 & pose)
+{
+  if (duojin02_scan_geometry::legacyContract(scan_geometry_config_)) {
+    return pose_helper_->getOdomPose(pose, scan.header.stamp);
+  }
+  const auto key = duojin02_scan_geometry::frameName(scan.header.frame_id) + ":" +
+    std::to_string(duojin02_scan_geometry::stampNs(scan.header.stamp));
+  std::lock_guard<std::mutex> lock(physical_scan_mutex_);
+  const auto found = prepared_physical_scans_.find(key);
+  if (found == prepared_physical_scans_.end()) {return false;}
+  const auto & reference = found->second.geometry.odom_from_base_reference;
+  pose = Pose2(reference.x, reference.y, reference.yaw);
+  return true;
+}
+
+void SlamToolbox::enqueuePhysicalScan(sensor_msgs::msg::LaserScan::ConstSharedPtr scan)
+{
+  std::lock_guard<std::recursive_mutex> dispatch_lock(physical_dispatch_mutex_);
+  // D0 identity follows the historical path and introduces no extra TF dependency.
+  if (duojin02_scan_geometry::legacyContract(scan_geometry_config_)) {
+    try {
+      (void)physicalScanStamp(*scan);
+      laserCallback(scan);
+    } catch (const duojin02_scan_geometry::Error & error) {
+      RCLCPP_WARN(get_logger(), "scan_geometry_drop raw_stamp=%ld reason=%s",
+        static_cast<int64_t>(scan->header.stamp.sec) * 1000000000 + scan->header.stamp.nanosec,
+        error.what());
+    }
+    return;
+  }
+  if (pending_physical_scans_.size() >= max_pending_physical_scans_) {
+    RCLCPP_ERROR(get_logger(), "scan_geometry_drop reason=pending_queue_limit raw_stamp=%ld",
+      static_cast<int64_t>(scan->header.stamp.sec) * 1000000000 + scan->header.stamp.nanosec);
+    return;
+  }
+  pending_physical_scans_.push_back({scan, std::chrono::steady_clock::now()});
+  drainPhysicalScans();
+}
+
+void SlamToolbox::drainPhysicalScans()
+{
+  std::lock_guard<std::recursive_mutex> dispatch_lock(physical_dispatch_mutex_);
+  while (!pending_physical_scans_.empty()) {
+    const auto pending = pending_physical_scans_.front();
+    const auto scan = pending.scan;
+    try {
+      auto geometry = scan_geometry_config_.enabled ?
+        scan_geometry_->prepare(*scan, scan_geometry_config_, odom_frame_, base_frame_) :
+        scan_geometry_->prepareReference(*scan, scan_geometry_config_, odom_frame_, base_frame_);
+      {
+        std::lock_guard<std::mutex> lock(physical_scan_mutex_);
+        for (auto it = prepared_physical_scans_.begin(); it != prepared_physical_scans_.end();) {
+          if (it->second.source.expired()) {it = prepared_physical_scans_.erase(it);} else {++it;}
+        }
+        const auto key = geometry.source_scan_id;
+        if (prepared_physical_scans_.count(key) != 0) {
+          throw duojin02_scan_geometry::Error(duojin02_scan_geometry::Failure::InvalidInput,
+            "duplicate source scan ID while an earlier scan is still queued");
+        }
+        prepared_physical_scans_[key] = {scan, std::move(geometry)};
+      }
+    } catch (const duojin02_scan_geometry::Error & error) {
+      const double waited = std::chrono::duration<double>(
+        std::chrono::steady_clock::now() - pending.received).count();
+      if ((error.reason == duojin02_scan_geometry::Failure::MissingFuture ||
+        error.reason == duojin02_scan_geometry::Failure::MissingFrame) &&
+        waited < pending_physical_scan_timeout_sec_) {return;}
+      RCLCPP_WARN(get_logger(), "scan_geometry_drop raw_stamp=%ld reason=%s waited_sec=%.6f",
+        static_cast<int64_t>(scan->header.stamp.sec) * 1000000000 + scan->header.stamp.nanosec,
+        error.what(), waited);
+      pending_physical_scans_.pop_front();
+      continue;
+    }
+    pending_physical_scans_.pop_front();
+    laserCallback(scan);
+  }
+}
+
+bool SlamToolbox::scanGeometryContractMatches(const std::string & prefix) const
+{
+  std::ifstream input(prefix + ".scan_geometry.json");
+  if (!input) {return duojin02_scan_geometry::legacyContract(scan_geometry_config_);}
+  const std::string actual((std::istreambuf_iterator<char>(input)), std::istreambuf_iterator<char>());
+  return actual == duojin02_scan_geometry::contractJson(scan_geometry_config_);
 }
 
