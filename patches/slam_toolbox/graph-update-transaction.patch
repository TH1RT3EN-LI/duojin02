+// A bundle is validated in full before any archive is deserialized. Legacy
+// prefixes remain supported and explicitly have no atomic bundle guarantee.
+inline std::string graphPrefix(const std::string & requested, std::string * verified_laser_bindings = nullptr)
+{
+  fs::path directory(requested);
+  if (!fs::is_directory(directory)) {
+    if (verified_laser_bindings) {*verified_laser_bindings = requested + ".laser_bindings.json";}
+    return requested;
+  }
+  boost::property_tree::ptree manifest;
+  boost::property_tree::read_json((directory / "snapshot.json").string(), manifest);
+  if (manifest.get<int>("schema_version") != 2 ||
+    manifest.get<std::string>("consistency") != "single_graph_owner_boundary") {
+    throw std::runtime_error("Unsupported or inconsistent snapshot bundle");
+  }
+  const auto producer = manifest.get<std::string>("producer");
+  if (producer != "slam_toolbox.SaveSnapshot.v1" && producer != "slam_toolbox.SaveSnapshot.v2") {
+    throw std::runtime_error("Unsupported bundle producer");
+  }
+  const std::string operation = manifest.get<std::string>("operation");
+  const std::string request_id = manifest.get<std::string>("request_id");
+  if ((operation != "snapshot" && operation != "finalize") ||
+    manifest.get<bool>("finalized") != (operation == "finalize") ||
+    (operation == "finalize") != !request_id.empty()) {
+    throw std::runtime_error("Invalid bundle operation identity");
+  }
+  std::map<std::string, std::string> roles, identities;
+  std::set<std::string> names;
+  for (const auto & entry : manifest.get_child("files")) {
+    const auto & item = entry.second;
+    const std::string name = item.get<std::string>("path");
+    const fs::path relative(name);
+    if (relative.empty() || relative.is_absolute() || relative.has_parent_path()) {
+      throw std::runtime_error("Invalid snapshot member path");
+    }
+    const auto member = directory / relative;
+    const auto role = item.get<std::string>("role");
+    if (role.empty() || name == "snapshot.json" || !names.insert(name).second ||
+      !roles.emplace(role, name).second || !fs::is_regular_file(member) || fs::is_symlink(member) ||
+      fs::file_size(member) != item.get<std::uintmax_t>("size_bytes") ||
+      sha256File(member) != item.get<std::string>("sha256")) {
+      throw std::runtime_error("Snapshot member verification failed: " + name);
+    }
+    identities[role] = role + "\t" + name + "\t" + item.get<std::string>("sha256") + "\t" +
+      std::to_string(item.get<std::uintmax_t>("size_bytes")) + "\n";
+  }
+  std::string identity;
+  for (const auto & item : identities) {identity += item.second;}
+  identity += operation + "\n" + request_id + "\n";
+  if (sha256Text(identity) != manifest.get<std::string>("snapshot_id")) {
+    throw std::runtime_error("Snapshot identity does not match its members");
+  }
+  for (const auto & role : {"yaml", "image", "posegraph", "data", "graph_update", "scan_geometry", "input_boundary", "runtime"}) {
+    if (!roles.count(role)) {throw std::runtime_error("Snapshot is not a resumable graph bundle");}
+  }
+  if (roles.count("laser_bindings") && roles.at("laser_bindings") != "laser_bindings.json") {throw std::runtime_error("Unsupported laser binding member path");}
+  if (!roles.count("laser_bindings") && fs::exists(directory / "laser_bindings.json")) {throw std::runtime_error("Unmanifested laser binding sidecar in graph bundle");}
+  if (verified_laser_bindings) {*verified_laser_bindings = roles.count("laser_bindings") ? (directory / roles.at("laser_bindings")).string() : std::string();}
+  if (producer == "slam_toolbox.SaveSnapshot.v2" && (!roles.count("laser_bindings") || roles.at("laser_bindings") != "laser_bindings.json")) {throw std::runtime_error("Snapshot v2 requires laser frame bindings");}
+  if (operation == "finalize") {
+    boost::property_tree::ptree boundary;
+    boost::property_tree::read_json((directory / roles.at("input_boundary")).string(), boundary);
+    if (!boundary.get<bool>("admissions_paused") || !boundary.get<bool>("queues_drained")) {
+      throw std::runtime_error("Finalize does not declare a paused/drained input boundary");
+    }
+  }
+  if (roles.at("posegraph") != "graph.posegraph" || roles.at("data") != "graph.data" ||
+    roles.at("scan_geometry") != "scan_geometry.json") {
+    throw std::runtime_error("Unsupported graph bundle layout");
+  }
+  return (directory / "graph").string();
 }
 
