+    // by ordinary consumers, including the host user of a root-run container.
+    fs::permissions(pending_, fs::perms::owner_all | fs::perms::group_read |
+      fs::perms::group_exec | fs::perms::others_read | fs::perms::others_exec);
+    syncPath(pending_, true);
+    if (::syscall(SYS_renameat2, AT_FDCWD, pending_.c_str(), AT_FDCWD, target_.c_str(), RENAME_NOREPLACE) != 0) {
+      throw std::runtime_error("Cannot publish immutable snapshot: " + std::string(std::strerror(errno)));
+    }
+    pending_.clear();
+    syncPath(target_.parent_path(), true);
+    return id;
+  }
+private:
+  fs::path target_, pending_;
+  std::vector<BundleFile> files_;
+};
