+void MapperGraph::RecordUpdate(const std::string & stage, const std::string & reason,
+  const GraphUpdateResult & result, LocalizedRangeScan * query,
+  const GraphBackendSnapshot * captured) const
+{
+  auto * solver=m_pMapper->m_pScanOptimizer;
+  // No graph walk, backend snapshot, status copy, digest, or JSON construction
+  // is permitted before diagnostic interest has been established.
+  if (!solver || !solver->WantsMatchDiagnostics()) {return;}
+  std::ostringstream out;out << std::setprecision(17)
+    << "{\"stage\":\"graph_update\",\"phase\":";MatchJsonString(out,stage);
+  out << ",\"reason\":";MatchJsonString(out,reason);
+  out << ",\"query_id\":" << (query?query->GetUniqueId():-1)
+    << ",\"query_raw_stamp_ns\":" << (query?query->GetRawScanStampNs():0)
+    << ",\"attempted\":" << (result.attempted?"true":"false")
+    << ",\"numerical_accepted\":" << (result.numerical_accepted?"true":"false")
+    << ",\"joint_committed\":" << (result.committed && !result.reused?"true":"false")
+    << ",\"reused_result\":" << (result.reused?"true":"false") << ",\"decision\":";
+  MatchJsonString(out,result.decision);out << ",\"native_decision\":";MatchJsonString(out,result.native_decision);
+  if (stage=="reference_update" && query) {
+    out << ",\"reference_delta\":{\"node_id\":" << query->GetUniqueId()
+      << ",\"raw_stamp_ns\":" << query->GetRawScanStampNs() << ",\"base_pose\":";
+    MatchJsonPose(out,query->GetCorrectedPose());out << '}';
+  }
+  out << ",\"state_scope\":\"" << (captured?"full_boundary":"maintained_status") << "\",\"state\":";
+  if (captured) {out << GetUpdateMetadataJson(captured);}
+  else {out << GetUpdateStatusJson(solver->GetBackendStatus());}
+  out << '}';solver->RecordMatchDiagnostic(out.str());
+}
+GraphUpdateResult MapperGraph::RequestUpdate(const std::string & reason,
+  LocalizedRangeScan * query, const std::string & request_id)
+{
+  auto owner=m_pMapper->LockGraphState();AssertHealthy();
+  auto & state=m_UpdateState;const bool explicit_request=reason=="finalize" || reason=="manual";
+  ++state.request_count;
+  GraphUpdateResult result;result.graph_revision=state.graph_revision;
+  result.covered_graph_revision=state.covered_graph_revision;result.commit_id=state.commit_id;
+  result.reference_pose_revision=state.reference_pose_revision;
+  auto * solver=m_pMapper->m_pScanOptimizer;
+  const auto initial_status=solver?solver->GetBackendStatus():GraphBackendStatus{};
+  result.backend_pose_revision=initial_status.pose_revision;
+  result.attempt_id=state.attempt_id;
+  auto finish=[&](const std::string & decision) {
+    result.decision=decision;state.last_decision=decision;
+    if (reason=="finalize" && !request_id.empty()) {state.finalize_requests.emplace(request_id,result);}
+    RecordUpdate("result",reason,result,query);return result;
+  };
+  if (solver && solver->SupportsPreparedTransactions() &&
+    (!initial_status.available || !initial_status.status_complete)) {
+    return finish("backend_status_capability_unknown");
+  }
+  if (reason=="finalize") {
+    if (request_id.empty()) {return finish("finalize_request_id_required");}
+    auto previous=state.finalize_requests.find(request_id);
+    if (previous!=state.finalize_requests.end()) {
+      if (previous->second.graph_revision!=state.graph_revision ||
+        previous->second.reference_pose_revision!=state.reference_pose_revision ||
+        previous->second.backend_pose_revision!=result.backend_pose_revision) {return finish("finalize_request_id_stale");}
+      result=previous->second;result.reused=true;result.attempted=false;RecordUpdate("idempotent_result",reason,result,query);return result;
+    }
+  }
+  if (!solver || !solver->SupportsPreparedTransactions()) {return finish("backend_transaction_capability_unknown");}
+  const auto before=solver->GetBackendSnapshot();
+  if (!before.known || !RegistryMatchesBackend(before)) {
+    MarkFault("backend_mapper_registry_mismatch");throw std::runtime_error("backend/mapper registry mismatch");
+  }
+  if (before.constraints.empty()) {return finish("no_registered_residual");}
+  if (!explicit_request && state.covered_graph_revision==state.graph_revision) {return finish("already_covered");}
+  // All ordinary reasons share one budget. A new query with an unchanged graph
+  // does not silently retry the previous failure; explicit requests own budgets.
+  if (!explicit_request && state.last_attempted_graph_revision==state.graph_revision) {
+    return finish("unchanged_graph_already_attempted");
+  }
+  state.last_attempted_graph_revision=state.graph_revision;
+  state.last_attempted_query=query?query->GetUniqueId():-1;
+  state.last_attempted_seed=UpdateSeedDigest(before.nodes);
+  ++state.attempt_id;result.attempt_id=state.attempt_id;result.attempted=true;
+  RecordUpdate("attempt",reason,result,query);
+  ScanSolver::PreparedHandle prepared;
+  ScanSolver::IdPoseVector mapper_before;
+  for (const auto & sensor : GetVertices()) for (const auto & item : sensor.second) {
+    auto * scan=item.second->GetObject();mapper_before.emplace_back(scan->GetUniqueId(),scan->GetCorrectedPose());
+  }
+  std::sort(mapper_before.begin(),mapper_before.end(),[](const auto & a,const auto & b){return a.first<b.first;});
+  auto abort=[&]() {
+    bool mapper_restored=true;
+    for (const auto & entry : mapper_before) {
+      auto * scan=m_pMapper->m_pMapperSensorManager->GetScan(entry.first);
+      try {if (!scan) {mapper_restored=false;} else {scan->SetCorrectedPoseAndUpdate(entry.second);}}
+      catch (...) {mapper_restored=false;}
+    }
+    bool backend_restored=false;
+    try {backend_restored=prepared && solver->AbortPrepared(prepared);}
+    catch (...) {backend_restored=false;}
+    const auto actual=solver->GetBackendSnapshot();
+    if (!mapper_restored || !backend_restored || !RegistryMatchesBackend(actual) ||
+      !UpdateBackendSame(actual,before)) {
+      MarkFault("joint_rollback_failed");throw std::runtime_error("joint state rollback failed; reset required");
+    }
+    for (const auto & entry : mapper_before) {
+      if (!UpdatePoseEqual(m_pMapper->m_pMapperSensorManager->GetScan(entry.first)->GetCorrectedPose(),entry.second)) {
+        MarkFault("mapper_rollback_verification_failed");throw std::runtime_error("mapper rollback verification failed");
       }
-      scan->SetCorrectedPoseAndUpdate(iter->second);
-    }
-
-    pSolver->Clear();
-    return true;
-  }
-  return false;
-}
+    }
+  };
+  bool joint_finalized=false;
+  try {
+    prepared=solver->PrepareSolve();
+    if (!prepared) {return finish("prepare_not_supported");}
+    state.last_attempted_profile=prepared->profile;
+    result.numerical_accepted=prepared->numerical_accepted;result.native_decision=prepared->decision;
+    if (!prepared->numerical_accepted) {abort();return finish("numerical_rejected_factor_retained");}
+    const auto restored=solver->GetBackendSnapshot();
+    std::map<int,Pose2> candidate;
+    bool valid=UpdateBackendSame(prepared->before,before) && UpdateBackendSame(restored,before) &&
+      state.graph_revision==result.graph_revision;
+    std::set<int> expected_ids;
+    for (const auto & entry : before.nodes) {expected_ids.insert(entry.first);}
+    for (const auto & entry : prepared->candidate) {
+      valid=valid && UpdatePoseFinite(entry.second) && candidate.emplace(entry.first,entry.second).second;
+    }
+    std::set<int> candidate_ids;for (const auto & entry : candidate) {candidate_ids.insert(entry.first);}
+    valid=valid && candidate_ids==expected_ids && mapper_before.size()==expected_ids.size();
+    if (query) {valid=valid && candidate.count(query->GetUniqueId())!=0;}
+    for (std::size_t i=0;i<before.nodes.size() && valid;++i) {
+      valid=restored.nodes[i].first==before.nodes[i].first && prepared->before.nodes[i].first==before.nodes[i].first &&
+        UpdatePoseEqual(restored.nodes[i].second,before.nodes[i].second) &&
+        UpdatePoseEqual(prepared->before.nodes[i].second,before.nodes[i].second);
+    }
+    if (before.anchor_valid) {
+      valid=valid && candidate.count(before.anchor_id) && UpdatePoseEqual(candidate.at(before.anchor_id),before.anchor_pose);
+    }
+    if (!valid || !RegistryMatchesBackend(restored)) {abort();return finish("complete_candidate_validation_rejected");}
+    if (!solver->CommitPrepared(prepared)) {abort();return finish("backend_commit_rejected");}
+    bool reference_changed=false;
+    for (const auto & entry : prepared->candidate) {
+      auto * scan=m_pMapper->m_pMapperSensorManager->GetScan(entry.first);
+      reference_changed=reference_changed || !UpdatePoseEqual(scan->GetCorrectedPose(),entry.second);
+      scan->SetCorrectedPoseAndUpdate(entry.second);
+    }
+    const auto applied=solver->GetBackendSnapshot();
+    valid=applied.nodes.size()==prepared->candidate.size() && RegistryMatchesBackend(applied);
+    for (const auto & entry : applied.nodes) {
+      auto * scan=m_pMapper->m_pMapperSensorManager->GetScan(entry.first);
+      valid=valid && scan && candidate.count(entry.first) && UpdatePoseEqual(entry.second,candidate.at(entry.first)) &&
+        UpdatePoseEqual(scan->GetCorrectedPose(),entry.second);
+    }
+    if (!valid || !solver->FinalizePrepared(prepared)) {abort();return finish("joint_commit_validation_rejected");}
+    joint_finalized=true; // Both containers are committed; the backend guard is released.
+    if (reference_changed) {++state.reference_pose_revision;}
+    state.covered_graph_revision=state.graph_revision;++state.commit_id;
+    result.committed=true;result.covered_graph_revision=state.covered_graph_revision;result.commit_id=state.commit_id;
+    result.reference_pose_revision=state.reference_pose_revision;result.backend_pose_revision=solver->GetBackendStatus().pose_revision;
+    return finish(prepared->gradient_tolerance_met?"joint_committed_stationary":"joint_committed_not_stationary");
+  } catch (...) {
+    if (state.faulted) {throw;}
+    if (joint_finalized) {
+      // Recording cannot undo a completed joint commit. Preserve consistent
+      // values/versions, fail stop, and do not invoke an already released guard.
+      MarkFault("joint_commit_recording_failed");throw;
+    }
+    if (!prepared) {
+      // Prepare's checked exception contract restores the backend. Independently
+      // verify values before allowing a subsequent graph version to continue.
+      const auto current=solver->GetBackendSnapshot();bool restored=current.nodes.size()==before.nodes.size();
+      for (std::size_t i=0;i<before.nodes.size() && restored;++i) {
+        restored=current.nodes[i].first==before.nodes[i].first && UpdatePoseEqual(current.nodes[i].second,before.nodes[i].second);
+      }
+      if (!restored || !UpdateBackendSame(current,before) || !RegistryMatchesBackend(current)) {MarkFault("prepare_exception_not_restored");throw;}
+      return finish("prepare_exception_factor_retained");
+    }
+    abort();return finish("joint_exception_rolled_back_factor_retained");
+  }
+}
