+void Mapper::CaptureGraphCheckpoint()
+{
+  auto owner=LockGraphState();
+  if (!m_pGraph || !m_pScanOptimizer || !m_pScanOptimizer->SupportsPreparedTransactions()) {
+    throw std::runtime_error("snapshot requires a complete backend checkpoint capability");
+  }
+  m_pGraph->AssertHealthy();
+  const auto backend=m_pScanOptimizer->GetBackendSnapshot();
+  if (!m_pGraph->RegistryMatchesBackend(backend)) {throw std::runtime_error("cannot snapshot inconsistent graph registration");}
+  if (!backend.known || backend.transaction_active || !backend.solver_options_complete) {
+    throw std::runtime_error("backend checkpoint unknown, transaction active, or solver options incomplete");
+  }
+  std::map<std::pair<int,int>,std::uint64_t> registration_ids;
+  std::set<std::uint64_t> unique_registration_ids;
+  for (const auto & record : backend.constraints) {
+    if (record.registration_id==0 || record.registration_id>backend.registration_id_watermark ||
+      !unique_registration_ids.insert(record.registration_id).second ||
+      !registration_ids.emplace(std::make_pair(record.source_id,record.target_id),record.registration_id).second) {
+      throw std::runtime_error("cannot snapshot incomplete backend registration identities");
+    }
+  }
+  // A full read-only boundary marker allows the lossless light event journal
+  // to bind the exact state saved by Snapshot/F0/F1. It consumes no request.
