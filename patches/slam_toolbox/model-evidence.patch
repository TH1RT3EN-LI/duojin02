+bool MapperGraph::RejectPendingScan(LocalizedRangeScan * scan, const Pose2 & originalPose)
+{
+  auto * vertex=GetVertex(scan);
+  if (m_pMapper->m_pScanOptimizer) m_pMapper->m_pScanOptimizer->RemoveNode(scan->GetUniqueId());
+  Graph<LocalizedRangeScan>::RemoveVertex(scan->GetSensorName(),scan->GetStateId());
+  delete vertex;
+  m_pMapper->m_pMapperSensorManager->UndoAddScan(scan);
+  scan->SetSensorPose(originalPose);
+  scan->SetStateId(-1);scan->SetUniqueId(-1);
+  return false;
 }
 
