+inline void syncPath(const fs::path & path, bool directory = false)
+{
+  const int fd = ::open(path.c_str(), O_RDONLY | (directory ? O_DIRECTORY : 0));
+  if (fd < 0) {throw std::runtime_error("Cannot open for fsync: " + path.string());}
+  const int result = ::fsync(fd);
+  const int error = errno;
+  ::close(fd);
+  if (result != 0) {throw std::runtime_error("fsync failed: " + std::string(std::strerror(error)));}
+}
+
+inline void writeText(const fs::path & path, const std::string & contents)
+{
+  std::ofstream output(path, std::ios::binary | std::ios::trunc);
+  output.exceptions(std::ios::badbit | std::ios::failbit);
+  output << contents;
+  output.close();
+  syncPath(path);
+}
