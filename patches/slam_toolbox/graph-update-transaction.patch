+inline std::vector<double> declaration(const sensor_msgs::msg::LaserScan & scan) {
+  std::vector<double> result={scan.angle_min,scan.angle_max,scan.angle_increment,scan.range_min,scan.range_max,double(scan.ranges.size())};
+  for(double value:result)if(!std::isfinite(value))throw std::runtime_error("Nonfinite laser declaration");
+  if(scan.angle_increment<=0||scan.range_min<0||scan.range_max<=scan.range_min||scan.ranges.empty())throw std::runtime_error("Invalid laser declaration");
+  return result;
+}
+inline std::string valuesJson(const std::vector<double> & values) {
+  if(values.empty())return "null";std::ostringstream out;out<<std::setprecision(17)<<'[';bool first=true;
+  for(double value:values){if(!std::isfinite(value))throw std::runtime_error("Nonfinite sensor declaration");if(!first)out<<',';first=false;out<<value;}out<<']';return out.str();
+}
+inline std::vector<double> calibration(const karto::LaserRangeFinder * sensor) {
+  const auto pose=sensor->GetOffsetPose();
+  return {pose.GetX(),pose.GetY(),pose.GetHeading(),sensor->GetMinimumRange(),sensor->GetMaximumRange(),
+    sensor->GetRangeThreshold(),sensor->GetMinimumAngle(),sensor->GetMaximumAngle(),sensor->GetAngularResolution(),
+    double(sensor->GetIs360Laser()),double(sensor->GetNumberOfRangeReadings())};
+}
+inline std::string calibrationJson(const karto::LaserRangeFinder * sensor) {
+  std::ostringstream out;out<<std::setprecision(17)<<'[';bool first=true;
+  for(double value:calibration(sensor)){if(!std::isfinite(value))throw std::runtime_error("Nonfinite laser calibration");if(!first)out<<',';first=false;out<<value;}out<<']';return out.str();
+}
+inline bool matches(const karto::LaserRangeFinder * sensor,const boost::property_tree::ptree & tree) {
+  std::vector<double> values;for(const auto & item:tree)values.push_back(item.second.get_value<double>());
+  return values==calibration(sensor);
+}
+inline std::map<std::string,karto::LaserRangeFinder *> sensors(const karto::Dataset & dataset) {
+  std::map<std::string,karto::LaserRangeFinder *> result;
+  for(auto * object:dataset.GetLasers()){
+    auto * sensor=dynamic_cast<karto::LaserRangeFinder *>(object);
+    if(!sensor)throw std::runtime_error("Archive contains a nonlaser sensor");
+    const auto name=sensor->GetName().ToString();const auto old=result.find(name);
+    if(old!=result.end()&&calibration(old->second)!=calibration(sensor))throw std::runtime_error("Ambiguous duplicate sensor name/calibration");
+    result[name]=sensor;
+  }return result;
+}
+inline std::string capture(const Table & table,const karto::Dataset & dataset,
+  bool legacy_pending,const std::string & history) {
+  const auto archived=sensors(dataset);std::set<std::string> covered;
+  std::ostringstream out;out<<"{\"schema\":\"slam-laser-bindings.v1\",\"history_policy\":"<<serialization::jsonString(history)
+    <<",\"calibration_order\":[\"offset_x\",\"offset_y\",\"offset_yaw\",\"minimum_range\",\"maximum_range\",\"range_threshold\",\"minimum_angle\",\"maximum_angle\",\"angular_resolution\",\"is360\",\"number_readings\"],\"frames\":[";
+  bool first=true;
+  for(const auto & entry:table){
+    auto metadata=entry.second;auto * sensor=metadata.getLaser();const auto name=sensor->GetName().ToString();
+    if(!archived.count(name)||calibration(archived.at(name))!=calibration(sensor)||!covered.insert(name).second)throw std::runtime_error("Nonbijective or unowned laser frame binding");
+    if(!first)out<<',';first=false;out<<"{\"frame\":"<<serialization::jsonString(entry.first)<<",\"sensor_name\":"<<serialization::jsonString(name)
+      <<",\"inverted\":"<<(metadata.isInverted()?"true":"false")<<",\"scan_declaration\":"<<valuesJson(metadata.scan_declaration)<<",\"calibration\":"<<calibrationJson(sensor)<<'}';
+  }
+  out<<"],\"unbound_single_sensor\":";
+  if(legacy_pending){
+    if(!table.empty()||archived.size()!=1)throw std::runtime_error("Invalid pending legacy sensor binding");const auto & sensor=*archived.begin();
+    out<<"{\"sensor_name\":"<<serialization::jsonString(sensor.first)<<",\"calibration\":"<<calibrationJson(sensor.second)<<'}';covered.insert(sensor.first);
+  }else out<<"null";
+  if(covered.size()!=archived.size())throw std::runtime_error("Snapshot has sensors without an explicit frame or legacy migration policy");
+  out<<"}\n";return out.str();
+}
+struct Restored {Table frames;bool legacy_pending{false};karto::LaserRangeFinder * legacy_sensor{nullptr};std::string history{"native_admission"};};
+inline Restored restore(const std::filesystem::path & path,const karto::Dataset & dataset) {
+  const auto archived=sensors(dataset);Restored result;
+  if(!std::filesystem::exists(path)){
+    if(archived.size()!=1)throw std::runtime_error("Legacy archive has no unique single sensor; frame identity cannot be recovered");
+    result.legacy_pending=true;result.legacy_sensor=archived.begin()->second;result.history="legacy_first_observation_pending";return result;
+  }
+  boost::property_tree::ptree root;boost::property_tree::read_json(path.string(),root);
+  if(root.get<std::string>("schema")!="slam-laser-bindings.v1")throw std::runtime_error("Unsupported laser binding schema");
+  result.history=root.get<std::string>("history_policy");std::set<std::string> covered;
+  const std::vector<std::string> order={"offset_x","offset_y","offset_yaw","minimum_range","maximum_range","range_threshold","minimum_angle","maximum_angle","angular_resolution","is360","number_readings"};
+  std::vector<std::string> actual;for(const auto & item:root.get_child("calibration_order"))actual.push_back(item.second.get_value<std::string>());
+  if(actual!=order)throw std::runtime_error("Unknown laser calibration field order");
+  for(const auto & entry:root.get_child("frames")){
+    const auto frame=entry.second.get<std::string>("frame"), name=entry.second.get<std::string>("sensor_name");
+    (void)duojin02_scan_geometry::frameName(frame);
+    if(frame.empty()||!archived.count(name)||!covered.insert(name).second||!matches(archived.at(name),entry.second.get_child("calibration"))||
+      !result.frames.emplace(frame,laser_utils::LaserMetadata(archived.at(name),entry.second.get<bool>("inverted"))).second)
+      throw std::runtime_error("Laser binding frame/name/calibration conflict");
+    const auto & declaration=entry.second.get_child("scan_declaration");
+    if(declaration.data()!="null"){
+      auto & values=result.frames.at(frame).scan_declaration;
+      for(const auto & item:declaration){const auto value=item.second.get_value<double>();if(!std::isfinite(value))throw std::runtime_error("Nonfinite archived scan declaration");values.push_back(value);}
+      if(values.size()!=6)throw std::runtime_error("Invalid archived scan declaration size");
+    }
+  }
+  const auto & pending=root.get_child("unbound_single_sensor");
+  if(pending.data()!="null"){
+    const auto name=pending.get<std::string>("sensor_name");
+    if(!result.frames.empty()||archived.size()!=1||!archived.count(name)||!matches(archived.at(name),pending.get_child("calibration")))throw std::runtime_error("Invalid legacy pending laser binding");
+    result.legacy_pending=true;result.legacy_sensor=archived.at(name);covered.insert(name);
+  }
+  if(covered.size()!=archived.size())throw std::runtime_error("Laser binding archive sensor coverage incomplete");return result;
+}
+} // namespace laser_binding_contract
+#endif
