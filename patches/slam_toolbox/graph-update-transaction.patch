+void CeresSolver::EnsureAnchorLocked()
+{
+  // Look up the anchor under the graph lock: unordered_map rehash invalidates iterators.
+  GraphIterator first_node = has_first_node_ ? nodes_->find(first_node_id_) : nodes_->end();
+  const auto is_constrained_pose = [this](GraphIterator candidate) {
+      if (candidate == nodes_->end() ||
+        !problem_->HasParameterBlock(&candidate->second(0)) ||
+        !problem_->HasParameterBlock(&candidate->second(1)) ||
+        !problem_->HasParameterBlock(&candidate->second(2)))
+      {
+        return false;
+      }
+      // Ceres retains parameter blocks after their last residual has been removed.
+      std::vector<ceres::ResidualBlockId> residual_blocks;
+      problem_->GetResidualBlocksForParameterBlock(&candidate->second(0), &residual_blocks);
+      return !residual_blocks.empty();
+    };
+  if (!is_constrained_pose(first_node)) {
+    // Release a surviving orphan before reanchoring, so reconnecting it cannot fix two poses.
+    if (was_constant_set_ && first_node != nodes_->end()) {
+      for (int axis = 0; axis < 3; ++axis) {
+        if (problem_->HasParameterBlock(&first_node->second(axis))) {
+          problem_->SetParameterBlockVariable(&first_node->second(axis));
+        }
+      }
+    }
+    // A removed or unconstrained anchor needs a deterministic, constrained replacement.
+    first_node = nodes_->end();
+    for (GraphIterator candidate = nodes_->begin(); candidate != nodes_->end(); ++candidate) {
+      if ((first_node == nodes_->end() || candidate->first < first_node->first) &&
+        is_constrained_pose(candidate))
+      {
+        first_node = candidate;
+      }
+    }
+    has_first_node_ = first_node != nodes_->end();
+    was_constant_set_ = false;
+    if (has_first_node_) {
+      first_node_id_ = first_node->first;
+    }
+  }
+
+  // Fix the surviving anchor's current pose, preserving the graph's coordinate frame.
+  if (!was_constant_set_ && has_first_node_) {
+    RCLCPP_DEBUG(node_->get_logger(),
+      "CeresSolver: Setting node %d as a constant pose:"
+      "%0.2f, %0.2f, %0.2f.", first_node->first, first_node->second(0),
+      first_node->second(1), first_node->second(2));
+    problem_->SetParameterBlockConstant(&first_node->second(0));
+    problem_->SetParameterBlockConstant(&first_node->second(1));
