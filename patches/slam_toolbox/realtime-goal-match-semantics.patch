+kt_double ScanMatcher::EvaluatePoseOnCurrentGrid(LocalizedRangeScan * scan, const Pose2 & pose)
+{
+  // Same native rounding, beam roster/coverage and immutable grid as the search.
+  const double center = std::nextafter(pose.GetHeading(), std::numeric_limits<double>::infinity());
+  m_pGridLookup->ComputeOffsets(scan, center, center - pose.GetHeading(), 1.0);
+  const auto cell = m_pCorrelationGrid->WorldToGrid(pose.GetPosition());
+  return GetResponse(0, m_pCorrelationGrid->GridIndex(cell));
 }
 
