+void MapperGraph::SetUpdatePolicy(const std::string & policy)
+{
+  auto owner=m_pMapper->LockGraphState();AssertHealthy();
+  if (policy!="loop_only" && policy!="keyframe") {throw std::invalid_argument("graph_update_policy must be loop_only or keyframe");}
