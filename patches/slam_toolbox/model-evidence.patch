+inline Mat sensorToBaseJacobian(const Pose2 & sensor, const Pose2 & offset) {
+  if(!std::isfinite(sensor.GetHeading()) || !std::isfinite(offset.GetHeading()) ||
+     !std::isfinite(offset.GetX()) || !std::isfinite(offset.GetY()))
