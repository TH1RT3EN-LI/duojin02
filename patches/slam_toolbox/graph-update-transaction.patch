+karto::ScanSolver::BackendStatus CeresSolver::GetBackendStatus() {
+  boost::mutex::scoped_lock lock(nodes_mutex_);
+  BackendStatus result;result.available=bool(problem_);
+  if(!problem_)return result;
+  result.status_complete=true;result.transaction_active=bool(active_prepared_);
+  result.candidate_applied=active_prepared_&&active_prepared_->applied;
+  result.diagnostics_enabled=diagnostics_.is_open();
+  result.epoch=backend_epoch_;result.topology_revision=topology_revision_;
+  result.pose_revision=pose_revision_;result.registration_id_watermark=next_edge_id_;
+  result.node_count=nodes_->size();result.registered_factor_count=blocks_->size();
+  result.solver_options_complete=!options_.linear_solver_ordering&&!options_.inner_iteration_ordering&&options_.callbacks.empty();
+  // EnsureAnchorLocked maintains these fields on every topology change. Full
+  // snapshots still independently verify actual Ceres parameter-block constancy.
+  const auto anchor=has_first_node_?nodes_->find(first_node_id_):nodes_->end();
+  if(was_constant_set_&&anchor!=nodes_->end()) {
+    result.anchor_valid=true;result.anchor_id=first_node_id_;
