+{
+void MatchJsonString(std::ostream & out, const std::string & value)
+{
+  out << '"';
+  for (unsigned char c : value) {
+    if (c == '"' || c == '\\') {out << '\\' << c;}
+    else if (c < 0x20) {out << "\\u" << std::hex << std::setw(4) << std::setfill('0') << int(c) << std::dec;}
+    else {out << c;}
+  }
+  out << '"';
+}
+void MatchJsonNumber(std::ostream & out, double value)
+{
+  if (std::isfinite(value)) {out << value;} else {out << "null";}
+}
+void MatchJsonPose(std::ostream & out, const Pose2 & pose)
+{
+  out << '['; MatchJsonNumber(out, pose.GetX()); out << ',';
+  MatchJsonNumber(out, pose.GetY()); out << ',';
+  MatchJsonNumber(out, pose.GetHeading()); out << ']';
+}
+// Diagnostic side channel: no values from this function feed matching or optimization.
+void RecordMapperMatch(ScanSolver * solver, const char * stage, const std::string & source,
+  const LocalizedRangeScan * query, const std::vector<int> & chain,
+  double coarse, double fine, const Pose2 & center, const Pose2 & result,
+  const Matrix3 & covariance, const char * decision, const char * reason,
+  int source_node_id = -1, double response_threshold = -1.0, double variance_threshold = -1.0)
+{
+  if (solver == NULL) {return;}
+  std::ostringstream out; out << std::setprecision(17);
+  out << "{\"stage\":"; MatchJsonString(out, stage);
+  out << ",\"provenance\":"; MatchJsonString(out, source);
+  out << ",\"query_id\":" << query->GetUniqueId()
+      << ",\"query_raw_stamp_ns\":" << query->GetRawScanStampNs()
+      << ",\"query_reference_stamp_ns\":" << query->GetPhysicalReferenceNs()
+      << ",\"query_sensor_name\":"; MatchJsonString(out, query->GetSensorName().ToString());
+  out << ",\"query_geometry_version\":"; MatchJsonString(out, query->GetGeometryVersion());
+  out << ",\"query_has_prepared_geometry\":" << (query->HasDeskewGeometry() ? "true" : "false")
+      << ",\"time_mapping_id\":"; MatchJsonString(out, query->GetTimeMappingId());
+  out << ",\"chain_ids\":[";
+  bool first = true; for (int id : chain) {if (!first) {out << ',';} first = false; out << id;}
+  out << "],\"source_node_id\":" << source_node_id << ",\"coarse_response\":"; MatchJsonNumber(out, coarse);
+  out << ",\"fine_response\":"; MatchJsonNumber(out, fine);
+  out << ",\"response_threshold\":"; MatchJsonNumber(out, response_threshold);
+  out << ",\"variance_threshold\":"; MatchJsonNumber(out, variance_threshold);
+  out << ",\"search_center_sensor_pose\":"; MatchJsonPose(out, center);
+  out << ",\"result_sensor_pose\":"; MatchJsonPose(out, result);
+  out << ",\"covariance_coordinates\":\"mapper_sensor_world_xy_yaw\",\"covariance_row_major\":[";
+  for (int row = 0; row < 3; ++row) {
+    for (int col = 0; col < 3; ++col) {if (row || col) {out << ',';} MatchJsonNumber(out, covariance(row,col));}
+  }
+  out << "],\"decision\":"; MatchJsonString(out, decision);
+  out << ",\"reason\":"; MatchJsonString(out, reason); out << '}';
+  solver->RecordMatchDiagnostic(out.str());
+}
+std::vector<int> MatchChainIds(const LocalizedRangeScanVector & chain)
+{
+  std::vector<int> result; for (const auto * scan : chain) {result.push_back(scan->GetUniqueId());}
+  return result;
+}
+std::vector<int> MatchChainIds(const LocalizedRangeScanMap & chain)
+{
+  std::vector<int> result;
+  for (const auto & scan : chain) {result.push_back(scan.second->GetUniqueId());}
+  return result;
+}
