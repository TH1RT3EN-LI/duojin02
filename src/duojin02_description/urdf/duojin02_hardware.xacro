<?xml version="1.0"?>
<robot name="duojin02_hardware" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="chassis_geometry.xacro" />

  <!-- Native CAD visuals use metres. Collision envelopes are independent. -->
  <xacro:macro name="mecanum_wheel_unit" params="prefix cad_name x y z radius width">
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link" />
      <child link="${prefix}_wheel" />
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0" />
      <axis xyz="0 1 0" />
    </joint>
    <link name="${prefix}_wheel">
      <visual>
        <geometry>
          <mesh filename="package://duojin02_description/meshes/chassis_${cad_name}_wheel.dae" />
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0" />
        <geometry>
          <cylinder radius="${radius}" length="${width}" />
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:macro name="duojin02_hardware_model">
    <link name="base_footprint" />
    <joint name="base_link_joint" type="fixed">
      <parent link="base_footprint" />
      <child link="base_link" />
      <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>
    <link name="base_link">
      <visual name="chassis_shell">
        <geometry><mesh filename="package://duojin02_description/meshes/chassis_shell.dae" /></geometry>
      </visual>
      <visual name="chassis_metal">
        <geometry><mesh filename="package://duojin02_description/meshes/chassis_metal.dae" /></geometry>
      </visual>
      <visual name="chassis_battery">
        <geometry><mesh filename="package://duojin02_description/meshes/chassis_battery.dae" /></geometry>
      </visual>
      <!-- Chassis body collision; wheel envelopes remain on their measured links. -->
      <collision name="chassis_body_envelope">
        <origin xyz="${chassis_body_center_x} ${chassis_body_center_y} ${chassis_body_center_z}" rpy="0 0 0" />
        <geometry><box size="${chassis_body_size_x} ${chassis_body_size_y} ${chassis_body_size_z}" /></geometry>
      </collision>
    </link>

    <xacro:mecanum_wheel_unit prefix="upper_left" cad_name="front_left"
      x="${front_left_x}" y="${front_left_y}" z="${front_left_z}"
      radius="${front_left_radius}" width="${front_left_width}" />
    <xacro:mecanum_wheel_unit prefix="lower_left" cad_name="rear_left"
      x="${rear_left_x}" y="${rear_left_y}" z="${rear_left_z}"
      radius="${rear_left_radius}" width="${rear_left_width}" />
    <xacro:mecanum_wheel_unit prefix="upper_right" cad_name="front_right"
      x="${front_right_x}" y="${front_right_y}" z="${front_right_z}"
      radius="${front_right_radius}" width="${front_right_width}" />
    <xacro:mecanum_wheel_unit prefix="lower_right" cad_name="rear_right"
      x="${rear_right_x}" y="${rear_right_y}" z="${rear_right_z}"
      radius="${rear_right_radius}" width="${rear_right_width}" />

    <joint name="lidar_mount_joint" type="fixed">
      <parent link="base_link" /><child link="lidar_mount" />
      <origin xyz="${lidar_mount_x} ${lidar_mount_y} ${lidar_mount_z}" rpy="0 0 0" />
    </joint>
    <link name="lidar_mount">
      <visual><geometry><mesh filename="package://duojin02_description/meshes/n10plus.dae" /></geometry></visual>
    </link>
    <!-- Zero marker faces forward (user confirmed). Optical height awaits calibration. -->
    <joint name="lidar_joint" type="fixed">
      <parent link="lidar_mount" /><child link="laser" />
      <origin xyz="0 0 ${lidar_scan_offset_z}" rpy="0 0 ${lidar_scan_yaw}" />
    </joint>
    <link name="laser" />
    <!-- CAD does not identify an IMU mounting datum; retain its existing transform. -->
    <joint name="imu_joint" type="fixed">
      <parent link="base_link" /><child link="imu_link" />
      <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>
    <link name="imu_link" />
  </xacro:macro>
</robot>
