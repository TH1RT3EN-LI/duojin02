+void CeresSolver::RecordMatchDiagnostic(const std::string & json)
+{
+  boost::mutex::scoped_lock lock(nodes_mutex_);
+  if (!diagnostics_.is_open()) {return;}
+  if (json.empty() || json.front() != '{' || json.back() != '}' ||
+    json.find('\n') != std::string::npos) {
+    throw std::invalid_argument("Mapper diagnostic must be a single JSON object");
+  }
+  diagnostics_ << "{\"event\":\"mapper_match\",\"match_id\":" << ++diagnostic_match_id_
+    << ",\"after_optimization_id\":" << optimization_id_
+    << ",\"detail\":" << json << "}\n";
+  FlushDiagnostics();
+}
+
+void CeresSolver::FlushDiagnostics()
+{
+  diagnostics_.flush();
+  if (!diagnostics_) {throw std::runtime_error("Failed to write Ceres graph diagnostics");}
+}
+
+void CeresSolver::WriteDiagnosticState(const char * phase, const ceres::Solver::Summary * summary)
+{
+  if (!diagnostics_.is_open()) {return;}
+  diagnostics_ << "{\"event\":\"" << phase << "\",\"optimization_id\":" << optimization_id_
+    << ",\"anchor_id\":";
+  if (has_first_node_) {diagnostics_ << first_node_id_;} else {diagnostics_ << "null";}
+  diagnostics_ << ",\"state_mode\":" << JsonString(diagnostic_state_mode_)
+    << ",\"node_count\":" << nodes_->size() << ",\"edge_count\":" << blocks_->size()
+    << (diagnostic_state_mode_ == "delta" ? ",\"changed_nodes\":[" : ",\"nodes\":[");
+  std::vector<int> ids;
+  for (const auto & entry : *nodes_) {ids.push_back(entry.first);}
+  std::sort(ids.begin(), ids.end());
+  bool first = true;
+  for (int id : ids) {
+    const auto & pose = nodes_->at(id);
+    const auto previous = diagnostic_nodes_.find(id);
+    if (diagnostic_state_mode_ == "delta" && previous != diagnostic_nodes_.end() &&
+      (previous->second.array() == pose.array()).all()) {continue;}
+    if (!first) {diagnostics_ << ',';} first = false;
+    diagnostics_ << '[' << id << ',' << JsonNumber{pose(0)} << ',' << JsonNumber{pose(1)} << ',' << JsonNumber{pose(2)} << ']';
+    diagnostic_nodes_[id] = pose;
+  }
+  diagnostics_ << ']';
+  // Delta mode records every edge definition once. Whitened residuals and robust cost
+  // are exactly reconstructible from these and the before/after node states.
+  if (diagnostic_state_mode_ == "full") {
+    diagnostics_ << ",\"edges\":[";
+    first = true;
+    for (const auto & entry : *blocks_) {
+      double cost = 0.0, residuals[3];
+      const bool valid = problem_->EvaluateResidualBlock(entry.second, false, &cost, residuals, nullptr);
+      if (!first) {diagnostics_ << ',';} first = false;
+      diagnostics_ << "{\"edge_id\":" << edge_ids_.at(entry.second) << ",\"whitened_squared_norm\":";
+      if (valid && std::isfinite(cost)) {
+        const double norm = 2.0 * cost;
+        double rho[3] = {norm, 1.0, 0.0};
+        if (loss_function_) {loss_function_->Evaluate(norm, rho);}
+        diagnostics_ << norm << ",\"rho_prime\":" << rho[1]
+          << ",\"robust_cost\":" << 0.5 * rho[0];
+      } else {
+        diagnostics_ << "null,\"rho_prime\":null,\"robust_cost\":null";
+      }
+      diagnostics_ << '}';
+    }
+    diagnostics_ << ']';
+  }
+  if (summary) {
+    diagnostics_ << ",\"usable\":" << (summary->IsSolutionUsable() ? "true" : "false")
+      << ",\"termination_type\":" << static_cast<int>(summary->termination_type)
+      << ",\"initial_cost\":" << JsonNumber{summary->initial_cost}
+      << ",\"final_cost\":" << JsonNumber{summary->final_cost}
+      << ",\"successful_steps\":" << summary->num_successful_steps
+      << ",\"unsuccessful_steps\":" << summary->num_unsuccessful_steps
+      << ",\"total_time_seconds\":" << JsonNumber{summary->total_time_in_seconds};
+  }
+  diagnostics_ << "}\n";
+  FlushDiagnostics();
+}
