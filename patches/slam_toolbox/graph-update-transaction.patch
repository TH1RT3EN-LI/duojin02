+    // cannot claim to continue an unrecorded historical optimizer seed.
+    auto & state=m_pGraph->m_UpdateState;state.seed_policy="mapper_seed_fallback";
+    state.covered_graph_revision=0;state.last_attempted_graph_revision=0;
+    state.finalize_requests.clear();state.last_decision="legacy_snapshot_mapper_seed_fallback";
+    m_pGraph->ObserveGraphDelta("legacy_graph_restored");
+    m_GraphUpdatePolicy=state.policy;
+    return true;
+  }
+  auto restored=m_pScanOptimizer->GetBackendSnapshot();
+  restored.nodes=m_CheckpointNodes;restored.anchor_valid=m_CheckpointAnchorValid;
+  restored.anchor_id=m_CheckpointAnchorId;restored.anchor_pose=m_CheckpointAnchorPose;
+  restored.epoch=m_CheckpointBackendEpoch;restored.topology_revision=m_CheckpointTopologyRevision;
+  restored.pose_revision=m_CheckpointPoseRevision;restored.objective_model=m_CheckpointObjectiveModel;
+  restored.solver_options=m_CheckpointSolverOptions;restored.solver_options_complete=m_CheckpointSolverOptionsComplete;
+  restored.registration_id_watermark=m_CheckpointRegistrationWatermark;
+  if (restored.constraints.size()!=m_CheckpointRegistrationIds.size()) {return false;}
+  std::set<std::uint64_t> unique_registration_ids;
+  for (auto & record : restored.constraints) {
+    const auto found=m_CheckpointRegistrationIds.find(std::make_pair(record.source_id,record.target_id));
+    if (found==m_CheckpointRegistrationIds.end() || found->second==0 ||
+      found->second>m_CheckpointRegistrationWatermark || !unique_registration_ids.insert(found->second).second) {return false;}
+    record.registration_id=found->second;
+  }
+  if (!m_pScanOptimizer->RestoreBackendSnapshot(restored) || !m_pGraph->RegistryMatchesBackend()) {return false;}
+  const auto actual=m_pScanOptimizer->GetBackendSnapshot();
+  if (actual.nodes.size()!=m_CheckpointNodes.size() || actual.anchor_valid!=m_CheckpointAnchorValid ||
+    actual.registration_id_watermark!=m_CheckpointRegistrationWatermark || actual.constraints.size()!=m_CheckpointRegistrationIds.size()) {return false;}
+  for (const auto & record : actual.constraints) {
+    const auto found=m_CheckpointRegistrationIds.find(std::make_pair(record.source_id,record.target_id));
+    if (found==m_CheckpointRegistrationIds.end() || found->second!=record.registration_id) {return false;}
+  }
+  for (std::size_t i=0;i<actual.nodes.size();++i) {
+    if (actual.nodes[i].first!=m_CheckpointNodes[i].first ||
+      !UpdatePoseEqual(actual.nodes[i].second,m_CheckpointNodes[i].second)) {return false;}
+  }
+  m_GraphUpdatePolicy=m_pGraph->m_UpdateState.policy;
+  return true;
+}
