+std::string JsonString(const std::string & value)
+{
+  std::ostringstream out;
+  out << '\"';
+  for (unsigned char c : value) {
+    if (c == '\"' || c == '\\') {out << '\\' << c;}
+    else if (c < 0x20) {out << "\\u" << std::hex << std::setw(4) << std::setfill('0') << int(c) << std::dec;}
+    else {out << c;}
+  }
+  out << '\"';
+  return out.str();
+}
+struct JsonNumber {double value;};
+std::ostream & operator<<(std::ostream & out, JsonNumber number)
+{
+  if (std::isfinite(number.value)) {out << number.value;} else {out << "null";}
+  return out;
+}
