 private:
+  void ValidatePreparedInput(const PointVectorDouble & points, const PointVectorDouble & origins,
+    const std::vector<std::int64_t> & stamps, const std::vector<kt_int32u> & indices,
+    const std::vector<std::uint8_t> & states) const
+  {
+    if (points.empty() || points.size() != GetNumberOfRangeReadings() ||
+      origins.size() != points.size() || stamps.size() != points.size() ||
+      indices.size() != points.size() || states.size() != points.size())
+    {throw Exception("Prepared geometry must preserve all original beam identities");}
+    if (!std::isfinite(m_SensorMinimumRange) || !std::isfinite(m_SensorMaximumRange) ||
+      m_SensorMinimumRange < 0 || m_SensorMaximumRange <= m_SensorMinimumRange)
+    {throw Exception("Prepared adapter requires explicit valid raw sensor limits");}
+    std::vector<bool> seen(points.size(), false);
+    for (size_t i = 0; i < points.size(); ++i) {
+      if (indices[i] >= seen.size() || seen[indices[i]] || states[i] > 2)
+      {throw Exception("Corrupt prepared beam identity");}
+      seen[indices[i]] = true;
+      const double raw = GetRangeReadings()[i];
+      const bool noReturn = (std::isinf(raw) && raw > 0) || raw == m_SensorMaximumRange;
+      const bool hit = std::isfinite(raw) && raw >= m_SensorMinimumRange && raw < m_SensorMaximumRange;
+      const std::uint8_t expected = noReturn ? 2 : hit ? 1 : 0;
+      if (states[i] != expected)
+      {throw Exception("Prepared beam state contradicts raw sensor validity");}
+      if (states[i] == 0) {continue;}
+      if (!std::isfinite(points[i].GetX()) || !std::isfinite(points[i].GetY()) ||
+        !std::isfinite(origins[i].GetX()) || !std::isfinite(origins[i].GetY()))
+      {throw Exception("Corrupt non-finite prepared ray");}
+      const double length = std::hypot(points[i].GetX() - origins[i].GetX(),
+        points[i].GetY() - origins[i].GetY());
+      const double distance = noReturn ? m_SensorMaximumRange : raw;
+      if (!std::isfinite(length) || std::abs(length - distance) > 1e-7 * (1 + distance))
+      {throw Exception("Prepared ray length contradicts raw measurement");}
+    }
+  }
+  void ValidatePreparedGeometry() const
+  {
+    if (!HasDeskewGeometry()) {
+      if (!m_LocalRayOrigins.empty() || !m_BeamStampNs.empty() ||
+        !m_OriginalBeamIndices.empty() || !m_BeamStates.empty())
+      {throw Exception("Prepared fields without authoritative geometry");}
+      return;
